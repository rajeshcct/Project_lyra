# Copy this file to ".env" (same folder) and fill in your real values.
# Never commit the real ".env" file — it's already in .gitignore.

# Which LLM backend to use: "groq" (Llama, fast/free) or "gemini"
LLM_PROVIDER=groq

# Only need to fill in the key for whichever provider you picked above.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional (Phase 6): how many rounds of tool calls a single request can
# chain through before Lyra forces a text-only final answer. Defaults to 5.
# MAX_TOOL_ROUNDS=5
